# OrbitLens — variables de entorno de referencia.
# No se cargan automáticamente: expórtalas en la shell o configúralas en el
# servicio de despliegue. Copiar como .env solo si tu herramienta lo soporta.

# Directorio de datos (caché, resultados y manifiestos)
ORBITLENS_DATA_DIR=data

# Endpoint SIA2 y colecciones vigentes (DR1 + QR3; no usar QR2 como fallback)
ORBITLENS_SIA_URL=https://irsa.ipac.caltech.edu/SIA
ORBITLENS_COLLECTIONS=spherex_dr1,spherex_qr3,spherex_dr1_deep,spherex_qr3_deep

# Hosts permitidos para recortes (coma-separados)
ORBITLENS_ALLOWED_HOSTS=irsa.ipac.caltech.edu

# Orígenes CORS del frontend en desarrollo
ORBITLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Selección temporal
ORBITLENS_DEFAULT_FRAMES=12
ORBITLENS_MAX_FRAMES=16
ORBITLENS_MAX_CANDIDATES=64
ORBITLENS_SEARCH_MAXREC=1000

# Rejilla de salida
ORBITLENS_PIXEL_SCALE_ARCSEC=6.15
ORBITLENS_MIN_VALID_FRACTION=0.70
ORBITLENS_CUTOUT_MARGIN=1.5

# Red, reintentos y cuotas
ORBITLENS_CONNECT_TIMEOUT_S=10
ORBITLENS_READ_TIMEOUT_S=120
ORBITLENS_RETRY_ATTEMPTS=3
ORBITLENS_RETRY_BACKOFF_S=1.0
ORBITLENS_CACHE_TTL_HOURS=24
ORBITLENS_EMPTY_CACHE_TTL_S=60

# Cola (un solo proceso worker; la cola no se comparte entre procesos)
ORBITLENS_MAX_WORKERS=3
ORBITLENS_MAX_ACTIVE_JOBS=32

ORBITLENS_MAX_ACTIVE_PER_IP=2
ORBITLENS_SEARCHES_PER_MINUTE=10
# Redes de proxies confiables; vacío ignora X-Forwarded-For.
# Arrancar uvicorn con --no-proxy-headers: la aplicación interpreta la cadena.
ORBITLENS_TRUSTED_PROXIES=
ORBITLENS_JOB_TIMEOUT_S=600
ORBITLENS_MAX_SIA_BYTES=16777216
ORBITLENS_MAX_DOWNLOAD_BYTES=104857600
ORBITLENS_MAX_JOB_DOWNLOAD_BYTES=536870912

# Presupuesto blando conjunto; LRU solo expulsa caché regenerable inactiva.
# Resultados publicados y entradas manuales protegidos: si llenan el presupuesto,
# se rechaza trabajo nuevo; no se borran automáticamente.
ORBITLENS_STORAGE_MAX_BYTES=2147483648
ORBITLENS_MIN_FREE_DISK_BYTES=67108864

# Perfil HTTP y exposición pública. En producción usar HTTPS y allowlist real.
# La aplicación falla al arrancar si production=true y falta el origen/host.
ORBITLENS_PRODUCTION=false
ORBITLENS_PUBLIC_ORIGIN=
ORBITLENS_ALLOWED_WEB_HOSTS=localhost,127.0.0.1
ORBITLENS_ENABLE_DOCS=false
ORBITLENS_SECURITY_CONTACT=
ORBITLENS_MAX_REQUEST_BYTES=16384
ORBITLENS_REQUEST_BODY_TIMEOUT_S=10
ORBITLENS_HTTP_REQUESTS_PER_MINUTE=600
ORBITLENS_HTTP_BURST=120
ORBITLENS_MAX_HTTP_CLIENTS=2048
# Nunca usar "*" ni 0.0.0.0/0. Ejemplo con proxy en la misma red Docker:
# ORBITLENS_TRUSTED_PROXIES=172.28.0.0/24
