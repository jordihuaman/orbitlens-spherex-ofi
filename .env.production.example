# Copiar como .env.production y completar. No versionar el archivo real.
# docker compose -f compose.yaml -f compose.production.yaml --env-file .env.production up -d --build

# Dominio público sin esquema; Caddy obtiene el certificado TLS.
ORBITLENS_DOMAIN=orbitlens.example.org
ORBITLENS_PUBLIC_ORIGIN=https://orbitlens.example.org
# Host(s) que acepta la aplicación. Incluye el dominio y, si se usa, localhost.
ORBITLENS_ALLOWED_WEB_HOSTS=orbitlens.example.org,localhost,127.0.0.1
# Red del proxy TLS. No usar 0.0.0.0/0 ni "*".
ORBITLENS_TRUSTED_PROXIES=172.28.0.0/24
# Contacto de divulgación responsable (mailto: o https:).
ORBITLENS_SECURITY_CONTACT=mailto:security@example.org
# Commit construido; visible en /api/health.
ORBITLENS_CODE_COMMIT=unknown
